   "title": "bytecode: structural facts the id rules rest on",
   "checks": [
    {
     "name": "MappedRegistry.register assigns id = byId.size() (registration order is the protocol id)",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "StateDefinition sorts properties by name (ImmutableSortedMap) before enumerating states",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "Blocks.<clinit> fills Block.BLOCK_STATE_REGISTRY by iterating BuiltInRegistries.BLOCK and each block's getPossibleStates() in order",
     "status": "ok",
     "detail": "in lambda$static$429"
    },
    {
     "name": "ProtocolInfo.Details.listPackets reports packet id = index in the builder's packet list",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "EntityDataSerializers.registerSerializer adds to a CrudeIncrementalIntIdentityHashBiMap, whose add() hands out nextId() (sequential ids)",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "Block.asItem() is Item.byBlock(block) = Item.BY_BLOCK.getOrDefault(block, Items.AIR)",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "Registries.elementsDirPath/tagsDirPath are '<path>' and 'tags/<path>'",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "TagNetworkSerialization.serializeTagsToNetwork starts from RegistrySynchronization.networkSafeRegistries",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "... and drops registries whose tag payload is empty (NetworkPayload.isEmpty)",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "networkSafeRegistries = all registries of RegistryLayer.STATIC (the built-in ones) + networkedRegistries(...)",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "networkedRegistries = registries from RegistryLayer.WORLD upwards filtered by isNetworkable (key in NETWORKABLE_REGISTRIES)",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "NETWORKABLE_REGISTRIES = keys of RegistryDataLoader.SYNCHRONIZED_REGISTRIES",
     "status": "ok",
     "detail": ""
    },
    {
     "name": "TagLoader.tryBuildTag collects entries in file order into a LinkedHashSet",
     "status": "ok",
     "detail": ""
    }
   ]
  },
